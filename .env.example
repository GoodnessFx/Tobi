# ============================================================
# Tobi Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Claude API Key (REQUIRED for primary intelligence)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (optional, for GPT routing)
# OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini (optional, for Gemini routing)
# GEMINI_API_KEY=your-key-here

# xAI Grok (optional, for Grok routing)
# GROK_API_KEY=xai-your-key-here

# GitHub (for repo, PR, and issue tracking)
# Get yours at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-token-here

# X / Twitter (for trending and social monitoring)
# Requires elevated API access
# X_BEARER_TOKEN=your-bearer-token-here

# TikTok (for trend monitoring)
# Requires TikTok Research API access
# TIKTOK_ACCESS_TOKEN=your-access-token-here

# Google Workspace OAuth installed-app client JSON file path
# GOOGLE_OAUTH_CLIENT_SECRETS=C:\path\to\client_secret.json

# NewsAPI (for news aggregation)
# NEWSAPI_KEY=your-key-here

# Model tier assignments (defaults shown; override if needed)
# CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# CLAUDE_BRAIN_MODEL=claude-sonnet-4-6
# CLAUDE_DEEP_MODEL=claude-opus-4-6

# Default tier for general chat: fast, brain, or deep
# CLAUDE_DEFAULT_TIER=brain

# Prefer Claude over Ollama when both are available
# PREFER_CLAUDE=true

# Cost alert thresholds (USD)
# COST_DAILY_ALERT=2.00
# COST_MONTHLY_ALERT=60.00

# Ollama fallback (used when Claude API is unreachable)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Voice settings
# WHISPER_MODEL=base.en
# TTS_ENGINE=kokoro
# TTS_VOICE=bf_emma

# Authentication
# Set a custom PIN for remote access (4-8 digits).
# If not set, Tobi auto-generates a random 6-digit PIN on first run.
# TOBI_PIN=1234
# Set to true to regenerate a random PIN (ignores TOBI_PIN)
# TOBI_REGEN_PIN=false

# Server ports
# API_PORT=8741
# UI_PORT=3741

# Logging
# LOG_LEVEL=INFO

# ============================================================
# Voice & TTS
# ============================================================

# ElevenLabs TTS (optional, higher quality)
# ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Web Push notifications (optional)
# Generate a VAPID key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_EMAIL=mailto:you@example.com

# Reminder audio storage
# REMINDER_AUDIO_DIR=/path/to/audio/storage

# Whisper language for STT (default: en)
# WHISPER_LANGUAGE=en

# ============================================================
# Digest / Proactive
# ============================================================

# GOAL_DRIFT_DAYS=7
# REMINDER_CHECK_INTERVAL=60

# ============================================================
# Focus Mode
# ============================================================

# FOCUS_DEFAULT_MINUTES=25

# ============================================================
# PWA / Frontend
# ============================================================

# TOBI_TUNNEL_DOMAIN=your-tunnel.trycloudflare.com

# ============================================================
# SMS (Dev mode, optional)
# ============================================================

# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# AFRICAS_TALKING_API_KEY=...
# AFRICAS_TALKING_USERNAME=...
