# ============================================================
# Tobi Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Claude API Key (REQUIRED for cloud intelligence)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Model tier assignments (defaults shown; override if needed)
# CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# CLAUDE_BRAIN_MODEL=claude-sonnet-4-6
# CLAUDE_DEEP_MODEL=claude-opus-4-6

# Default tier for general chat: fast, brain, or deep
# CLAUDE_DEFAULT_TIER=brain

# Prefer Claude over Ollama when both are available
# PREFER_CLAUDE=true

# Cost alert thresholds (USD)
# COST_DAILY_ALERT=2.00
# COST_MONTHLY_ALERT=60.00

# Ollama fallback (used when Claude API is unreachable)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Voice settings
# WHISPER_MODEL=base.en
# TTS_ENGINE=kokoro
# TTS_VOICE=af_heart

# Authentication
# Set a custom PIN for remote access (4-8 digits).
# If not set, Tobi auto-generates a random 6-digit PIN on first run.
# Tobi_PIN=1234
# Set to true to regenerate a random PIN (ignores Tobi_PIN)
# Tobi_REGEN_PIN=false

# Server ports
# API_PORT=8741
# UI_PORT=3741

# Logging
# LOG_LEVEL=INFO


# ============================================================
# Phase 0 Additions
# ============================================================

# ElevenLabs TTS (optional — use for higher-quality voice output)
# Sign up free at https://elevenlabs.io
# ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel

# Web Push notifications (optional — required for server-sent push to mobile)
# Generate a VAPID key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_EMAIL=mailto:you@example.com

# Reminder audio storage (default: data/reminder_audio/ inside the project)
# Override if you want clips stored elsewhere
# REMINDER_AUDIO_DIR=/path/to/audio/storage

# Whisper language for STT (default: en)
# WHISPER_LANGUAGE=en

# Digest / proactive settings
# GOAL_DRIFT_DAYS=7           # days before a goal is flagged as stale
# REMINDER_CHECK_INTERVAL=60  # seconds between due-reminder scans

# PWA / frontend
# Set this if you're hosting the Next.js UI behind a custom domain
# TOBI_TUNNEL_DOMAIN=your-tunnel.trycloudflare.com
